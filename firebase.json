{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/prototype/web/**",
        "destination": "/prototype/web/index.html"
      },
      {
        "source": "/prototype/mobile/**",
        "destination": "/prototype/mobile/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
